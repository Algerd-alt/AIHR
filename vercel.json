{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/((?!api/).*)",
      "dest": "/frontend/dist/$1",
      "fallback": true
    }
  ],
  "env": {
    "VITE_API_BASE": "https://sd7pglkr5ecdfn0ifso5g.apigateway-cn-beijing.volceapi.com"
  }
}
